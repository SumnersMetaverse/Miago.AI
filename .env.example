# MIAGO Platform Environment Variables
# Copy this file to .env and configure with your values

# Version
MIAGO_VERSION=1.0.1.0.11.1.0.1

# Network Configuration
BASE_IP=192.0.0.0
OAUTH_ENTRY_PORT=73571
REDIS_PORT=6379
HTTP_PORT=8080
DOCUSAURUS_PORT=3003

# Legacy Keys (DO NOT UPDATE until verified and accredited)
# These must be validated before modification
SEGMENT_ANALYTICS_KEY=your_segment_key_here
LD_CLIENT_ID=your_launchdarkly_id_here

# Service Hostnames (for Docker Compose)
REDIS_HOST=redis
OAUTH_SERVICE_HOST=oauth-service
HTTP_SERVICE_HOST=http-service

# Platform Configuration
PLATFORM_NAME=MIAGO
DOMAIN=miago.ai
